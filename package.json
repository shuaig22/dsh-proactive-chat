{
  "name": "dsh-proactive-chat",
  "version": "0.2.1",
  "displayName": "更像人的聊天",
  "description": "更像人的聊天：以主动续话为核心，在热聊中顺着话题继续往下接。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "onebot",
    "napcat",
    "qq",
    "proactive-chat",
    "proactive-continuation",
    "human-like-chat"
  ],
  "author": "shuaig22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuaig22/dsh-proactive-chat.git"
  },
  "homepage": "https://github.com/shuaig22/dsh-proactive-chat",
  "bugs": {
    "url": "https://github.com/shuaig22/dsh-proactive-chat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}

